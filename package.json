{
  "name": "retro-term-css",
  "version": "3.0.0",
  "description": "Lightweight standalone CSS framework for dashboards, admin panels, documentation pages, internal tools, and landing pages.",
  "license": "MIT",
  "author": "Afan Hermawan",
  "homepage": "https://retro-term.afandev.my.id/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/afandisini/Retro-term.git"
  },
  "bugs": {
    "url": "https://github.com/afandisini/Retro-term/issues"
  },
  "keywords": [
    "css",
    "css-framework",
    "admin-panel",
    "admin-dashboard",
    "dashboard",
    "landing-page",
    "documentation",
    "responsive",
    "ui-framework",
    "retro"
  ],
  "main": "dist/retro-term.min.js",
  "style": "dist/retro-term.min.css",
  "files": [
    "dist",
    "sass",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "style": "./dist/retro-term.min.css",
      "default": "./dist/retro-term.min.js"
    },
    "./css": "./dist/retro-term.css",
    "./css/min": "./dist/retro-term.min.css",
    "./js": "./dist/retro-term.js",
    "./js/min": "./dist/retro-term.min.js",
    "./icons": "./dist/retro-term-icons.css",
    "./icons/min": "./dist/retro-term-icons.min.css",
    "./scss": "./sass/retro-term.scss",
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "node scripts/clean-dist.js",
    "build:css": "node node_modules/sass/sass.js sass/retro-term.scss dist/retro-term.css --no-source-map && node node_modules/sass/sass.js sass/retro-term.scss dist/retro-term.min.css --style=compressed --no-source-map",
    "build:icons": "node scripts/copy-icons.js",
    "build:js": "node scripts/copy-js.js",
    "build": "npm run clean && npm run build:css && npm run build:js && npm run build:icons",
    "watch:css": "node node_modules/sass/sass.js --watch sass/retro-term.scss:dist/retro-term.css",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "sass": "^1.77.8",
    "terser": "^5.48.0"
  },
  "sideEffects": [
    "dist/*.css",
    "dist/*.js"
  ]
}
